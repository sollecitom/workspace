+package sollecitom.services.example.modules.compliance_plan_outputs_manager.application.model.report.csv
+
+internal fun csvRow(vararg fields: Any): String = fields.joinToString(separator = ",") { it.toString().asCsvField() }
+
+private fun String.asCsvField() = if (any { it == ',' || it == '"' || it == '\n' || it == '\r' }) "\"${replace("\"", "\"\"")}\"" else this
