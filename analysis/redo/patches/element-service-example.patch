+package sollecitom.services.example.modules.compliance_plans_viewer.adapters.driven.repository.postgres
+
+import sollecitom.libs.swissknife.core.domain.text.Name
+
+internal data class PagePosition(val stateOrder: Int, val primaryKey: Long) {
+
+    fun toContinuationToken() = Name("$stateOrder$SEPARATOR$primaryKey")
+
+    companion object {
+
+        private const val SEPARATOR = ':'
+
+        fun fromContinuationToken(token: Name): PagePosition {
+
+            val parts = token.value.split(SEPARATOR)
+            val stateOrder = parts.getOrNull(0)?.toIntOrNull()
+            val primaryKey = parts.getOrNull(1)?.toLongOrNull()
+            require(parts.size == 2 && stateOrder != null && primaryKey != null) { "Invalid continuation token" }
+            return PagePosition(stateOrder, primaryKey)
+        }
+    }
+}
