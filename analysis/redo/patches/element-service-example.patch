+@TestInstance(PER_CLASS)
+class CSVRequirementsReportGeneratorTests : CoreDataGenerator by CoreDataGenerator.testProvider {
+
+    private val generator = CSVRequirementsReportGenerator()
+
+    @Test
+    fun `generating a requirements report`() = testWithInvocationContext {
+
+        val publicationDate = YearMonth(2020, Month.JANUARY)
+        val standard = Standard.create(reference = Name("IEC 60601-1"), publicationDate = publicationDate)
+        val requirement = Requirement.create(
+            clause = Clause.create(name = Name("4.1"), standard = standard),
+            isMandatory = true,
+            summary = Text("Shall be \"safe\", always"),
+            conditionality = SummarizedConditionality(summary = Text("Only when powered")),
+            verificationRequirements = VerificationRequirements(VerificationRequirements.Method.Test)
+        ).applicable()
+
+        val report = generator.generate(requirements = flowOf(requirement))
+
+        assertThat(report.open().readAllBytes().decodeToString()).isEqualTo(
+            "Standard ID,Standard Publication Date,Clause,Mandatory?,Summary,Verification Requirements,Conditionality\n" +
+                    "IEC 60601-1,${publicationDate.displayName()},4.1,true,\"Shall be \"\"safe\"\", always\",Test,Only when powered"
+        )
+    }
+}
