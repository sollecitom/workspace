+import assertk.assertThat
+import assertk.assertions.isEqualTo
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.datetime.Month
+import kotlinx.datetime.YearMonth
+import sollecitom.libs.swissknife.core.domain.text.Name
+import sollecitom.libs.swissknife.core.test.utils.testProvider
+import sollecitom.libs.swissknife.core.utils.CoreDataGenerator
+import sollecitom.libs.swissknife.correlation.core.test.utils.testWithInvocationContext
+import sollecitom.libs.swissknife.kotlin.extensions.time.displayName
+import sollecitom.services.example.modules.compliance_plan_outputs_manager.application.model.report.csv.CSVStandardsReportGenerator
+import sollecitom.services.example.shared.compliance_plan.domain.model.standard.Standard
+import sollecitom.services.example.shared.compliance_plan.domain.model.standard.device.KeyFunctionalElement
+import sollecitom.services.example.shared.compliance_plan.domain.model.standard.organization.StandardsDevelopingOrganization.Companion.IEC
+import sollecitom.services.example.shared.compliance_plan.domain.model.standard.organization.StandardsDevelopingOrganization.Companion.ISO
+import sollecitom.services.example.shared.compliance_plan.domain.test.utils.standard.create
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.TestInstance
+import org.junit.jupiter.api.TestInstance.Lifecycle.PER_CLASS
+
+@TestInstance(PER_CLASS)
+class CSVStandardsReportGeneratorTests : CoreDataGenerator by CoreDataGenerator.testProvider {
+
+    private val generator = CSVStandardsReportGenerator()
+
+    @Test
+    fun `generating a standards report`() = testWithInvocationContext {
+
+        val publicationDate = YearMonth(2020, Month.JANUARY)
+        val standard = Standard.create(
+            publication = Standard.Publication(publishers = setOf(IEC, ISO), date = publicationDate, edition = Name("1.0")),
+            title = Name("Safety, \"basic\""),
+            type = Name("GENERAL"),
+            testingRequirements = null,
+            deviceKeyFunctionalElements = setOf(KeyFunctionalElement.WholeDevice),
+            applicabilityReasons = setOf(Standard.ApplicabilityReason.EssentialPrinciple(Name("EP-1")))
+        )
+
+        val report = generator.generate(standards = flowOf(standard))
+
+        assertThat(report.open().readAllBytes().decodeToString()).isEqualTo(
+            "Title,Publishers,Publication Date,Applicability Reasons,Key Functional Elements,Recommended Test Houses,Type\n" +
+                    "\"Safety, \"\"basic\"\"\",\"IEC, ISO\",${publicationDate.displayName()},EP-1,Whole device,N/A,GENERAL"
+        )
+    }
+}
