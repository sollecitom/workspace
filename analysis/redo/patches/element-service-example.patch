+context(_: InvocationContext<*>)
+private suspend fun CompliancePlansReader.retrieveAllPages(sortOrder: SortOrder?, pageSize: Int): List<CompliancePlan> {
+
+    val plans = mutableListOf<CompliancePlan>()
+    var continuationToken: Name? = null
+    do {
+        val page = retrieve(CompliancePlansSelector.All, sortOrder, Pagination.Arguments(limit = pageSize, continuationToken = continuationToken))
+        plans += page.items
+        continuationToken = page.information.continuationToken
+    } while (continuationToken != null)
+    return plans
+}
