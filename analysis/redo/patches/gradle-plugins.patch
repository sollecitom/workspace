diff --git a/components/base/src/test/kotlin/sollecitom/plugins/conventions/task/dependency/version/MinimumDependencyVersionTests.kt b/components/base/src/test/kotlin/sollecitom/plugins/conventions/task/dependency/version/MinimumDependencyVersionTests.kt
