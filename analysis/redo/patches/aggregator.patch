+#!/usr/bin/env just --justfile
+
+set quiet
+
+projects:
+    ./gradlew listIncludedBuilds
+
+help:
+    ./gradlew helpAll
+
+build:
+    ./gradlew buildAll
+
+update-internal-dependencies:
+    @:
+
+test:
+    ./gradlew testAll
+
+clean:
+    ./gradlew cleanAll
diff --git a/settings.gradle.kts b/settings.gradle.kts
new file mode 100644
index 0000000..f2c02bd
--- /dev/null
+++ b/settings.gradle.kts
@@ -0,0 +1,41 @@
+@file:Suppress("UnstableApiUsage")
+
+rootProject.name = "aggregator"
+
+pluginManagement {
+    repositories {
+        mavenLocal()
+        gradlePluginPortal()
+        mavenCentral()
+    }
+}
+
+dependencyResolutionManagement {
+    repositories {
+        mavenLocal()
+        mavenCentral()
+        maven("https://packages.confluent.io/maven")
+    }
+}
+
+val workspaceBuilds = listOf(
+    "gradle-plugins",
+    "acme-schema-catalogue",
+    "swissknife",
+    "pillar",
+    "tools",
+    "examples",
+    "facts",
+    "modulith-example",
+    "element-service-example",
+    "lattice",
+    "quality-scorer",
+)
+
+workspaceBuilds.forEach { repo ->
+    val repoDir = file("../$repo")
+    require(repoDir.isDirectory) {
+        "Expected sibling repo ../$repo for the aggregator composite build."
+    }
+    includeBuild(repoDir)
+}
