@@ -0,0 +1,64 @@
+# aggregator
+
+Composite-build workbench for cross-repo development across the sibling workspace repos.
+
+## Purpose
+
+This repo is a development convenience, not the release-like verification path.
+
+Use it when you want:
+
+- one Gradle entry point that wires all sibling repos through `includeBuild(...)`
+- cross-repo search/replace and source-level refactoring
+- simple composite tasks that can fan out into the included builds
+
+Do not use it as the source of truth for publishing, version updates, or workspace refresh flows. Those remain in the root [`workspace`](../README.md) repo.
+
+## Layout
+
+Expected sibling directory layout:
+
+```text
+~/workspace/
+  aggregator/
+  gradle-plugins/
+  acme-schema-catalogue/
+  swissknife/
+  pillar/
+  tools/
+  examples/
+  facts/
+  modulith-example/
+  element-service-example/
+  lattice/
+  quality-scorer/
+```
+
+## Commands
+
+```bash
+just projects
+just build
+just test
+just clean
+```
+
+Equivalent Gradle tasks:
+
+- `./gradlew listIncludedBuilds`
+- `./gradlew buildAll`
+- `./gradlew testAll`
+- `./gradlew cleanAll`
+
+## Workflow
+
+1. Open this repo when you want a composite build view across the workspace.
+2. Edit code in the real sibling repos.
+3. Run composite verification here if useful.
+4. Commit changes in the real underlying repos, not here, unless the aggregator wiring itself changed.
+
+## Non-Goals
+
+- No publishing authority
+- No replacement for the normal workspace orchestration flows
+- No git submodule ownership of the sibling repos
diff --git a/build.gradle.kts b/build.gradle.kts
new file mode 100644
index 0000000..970f4bb
--- /dev/null
+++ b/build.gradle.kts
@@ -0,0 +1,48 @@
+group = "sollecitom.aggregator"
+version = "1.0.0-SNAPSHOT"
+
+val includedBuilds = gradle.includedBuilds.sortedBy { it.name }
+
+fun registerCompositeTask(
+    name: String,
+    includedTask: String,
+    descriptionText: String,
+) {
+    tasks.register(name) {
+        group = "workspace"
+        description = descriptionText
+        dependsOn(includedBuilds.map { it.task(includedTask) })
+    }
+}
+
+tasks.register("listIncludedBuilds") {
+    group = "workspace"
+    description = "Print the included sibling repos wired into this composite build."
+    doLast {
+        includedBuilds.forEach { println(it.name) }
+    }
+}
+
+registerCompositeTask(
+    name = "helpAll",
+    includedTask = ":help",
+    descriptionText = "Run :help in every included build.",
+)
+
+registerCompositeTask(
+    name = "buildAll",
+    includedTask = ":build",
+    descriptionText = "Run :build in every included build.",
+)
+
+registerCompositeTask(
+    name = "testAll",
+    includedTask = ":test",
+    descriptionText = "Run :test in every included build.",
+)
+
+registerCompositeTask(
+    name = "cleanAll",
+    includedTask = ":clean",
+    descriptionText = "Run :clean in every included build.",
+)
