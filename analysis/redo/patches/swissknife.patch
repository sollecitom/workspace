diff --git a/modules/avro/serialization/utils/src/test/kotlin/sollecitom/libs/swissknife/avro/serialization/utils/AvroGenericRecordTests.kt b/modules/avro/serialization/utils/src/test/kotlin/sollecitom/libs/swissknife/avro/serialization/utils/AvroGenericRecordTests.kt
